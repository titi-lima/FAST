<?xml version="1.0" encoding="UTF-8"?>
<project name="ant-sample" default="help" xmlns:xi="http://www.w3.org/2001/XInclude">
    <import file=".fast/fast-tcp.xml"/>
    <description>Java 21 Ant project with JUnit 5</description>

    <property name="src.main" value="src/main/java"/>
    <property name="src.test" value="src/test/java"/>
    <property name="build.dir" value="build"/>
    <property name="classes.main" value="${build.dir}/classes/main"/>
    <property name="classes.test" value="${build.dir}/classes/test"/>
    <property name="lib.dir" value="lib"/>
    <property name="junit.console" value="${lib.dir}/junit-platform-console-standalone.jar"/>

    <target name="help">
        <echo>Targets:</echo>
        <echo>  clean          - Remove build outputs</echo>
        <echo>  compile        - Compile main and test classes (Java 21)</echo>
        <echo>  test           - Run tests with JUnit Console</echo>
        <echo>  fast-tcp       - Prioritize and run tests with FAST TCP</echo>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${classes.main}"/>
        <mkdir dir="${classes.test}"/>

        <javac includeantruntime="false" srcdir="${src.main}" destdir="${classes.main}" release="21" debug="true"/>
        <javac includeantruntime="false" srcdir="${src.test}" destdir="${classes.test}" release="21" debug="true">
            <classpath>
                <pathelement location="${classes.main}"/>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="compile">
        <fail unless="exists.junit.console" message="JUnit console jar not found. Run scripts/get-junit.sh"/>
        <path id="test.cp">
            <pathelement location="${classes.main}"/>
            <pathelement location="${classes.test}"/>
            <pathelement location="${junit.console}"/>
        </path>

        <java classname="org.junit.platform.console.ConsoleLauncher" fork="true">
            <classpath refid="test.cp"/>
            <arg value="--class-path"/>
            <arg path="${classes.main}:${classes.test}"/>
            <arg value="--scan-class-path"/>
        </java>
    </target>

    <!-- Property to assert existence of junit console jar -->
    <condition property="exists.junit.console">
        <and>
            <available file="${junit.console}"/>
        </and>
    </condition>
    <!-- FAST TCP initialization target -->
    <!-- FAST TCP initialization target -->
    <!-- FAST TCP initialization target -->
    <!-- FAST TCP initialization target -->
    <target name="fast-tcp">
        <fast-tcp-prioritize-and-run projectDir="${basedir}" algo="FAST-pw" repetitions="3"/>
    </target>
</project>


