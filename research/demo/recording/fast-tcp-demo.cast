[7.1495, "o", "\r\n"]
[7.1555, "o", "import pytest\r\nfrom pricing import shipping_cost\r\n\r\n\r\n@pytest.mark.parametrize(\"amount, express, expected\", [\r\n    (0, False, 5),\r\n    (10, False, 5),\r\n    (49, False, 5),\r\n    (50, False, 0),\r\n    (100, False, 0),\r\n    (0, True, 12),\r\n    (10, True, 12),\r\n    (49, True, 12),\r\n    (50, True, 12),\r\n    (100, True, 12),\r\n])\r\ndef test_shipping(amount, express, expected):\r\n    assert shipping_cost(amount, express) == expected\r\n"]
[7.1559, "o", "\u001b]777;ready\u0007"]
