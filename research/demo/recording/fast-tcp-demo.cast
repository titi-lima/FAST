[3.9134, "o", "\r\n"]
[3.9215, "o", "def subtotal(prices):\r\n    return round(sum(prices), 2)\r\n\r\n\r\ndef shipping_cost(amount, express=False):\r\n    if express:\r\n        return 12\r\n    return 0 if amount >= 50 else 5\r\n\r\n\r\ndef tax(amount, rate):\r\n    return round(amount * rate / 100, 2)\r\n\r\n\r\ndef discounted_price(price, percent):\r\n    return price * (1 - percent / 10)\r\n\r\n\r\ndef total_price(amount, rate=0, express=False):\r\n    return amount + tax(amount, rate) + shipping_cost(amount, express)\r\n"]
[3.9219, "o", "\u001b]777;ready\u0007"]
